{
  "name": "@defaultusr/vertical-timeline",
  "version": "1.1.1",
  "description": "Canvas-rendered vertical timeline with rich HTML event cards, storyline groups, bands and a minimap",
  "keywords": [
    "timeline",
    "vertical-timeline",
    "canvas",
    "events",
    "history",
    "visualization",
    "minimap"
  ],
  "type": "module",
  "main": "./dist/vertical-timeline.js",
  "module": "./dist/vertical-timeline.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vertical-timeline.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "preview:demo": "vite preview --config vite.demo.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "d3-scale": "^4.0.2"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedefaultusr/vertical-timeline.git"
  },
  "homepage": "https://thedefaultusr.github.io/vertical-timeline/",
  "bugs": {
    "url": "https://github.com/thedefaultusr/vertical-timeline/issues"
  },
  "license": "MIT"
}
